						},
						"htmlElementName": {
							"description": "A lower-case kebab-case name to be used for the custom element. Must contain at least one hyphen.",
							"pattern": "^[a-z]+-([a-z-]+)?[a-z]",
							"type": "string"
						},
						"instanceable": {
							"type": "boolean"
						},
						"jsonUrls": {
