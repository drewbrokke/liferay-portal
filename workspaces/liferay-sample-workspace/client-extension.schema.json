						},
						"singleURL": {
							"type": "string"
						},
						"urls": {
							"$ref": "#/definitions/datatype_uniqueStringArray"
						},
						"useESM": {
							"type": "boolean"
						}
					},
					"required": [
						"htmlElementName",
						"urls"
					],
					"type": "object"
				}
			],
			"description": "Description for customElement"
