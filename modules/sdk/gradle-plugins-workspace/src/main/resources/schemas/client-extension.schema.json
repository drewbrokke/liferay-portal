{
	"$comment": "This JSON schema is published to https://www.schemastore.org/json. It can be found by searching under 'Liferay client-extension.yaml.' IntelliJ IDEA and VS Code both come with support for detecting schemas from JSON Schema Store.",
	"$id": "https://raw.githubusercontent.com/liferay/liferay-portal/master/modules/sdk/gradle-plugins-workspace/src/main/resources/schemas/client-extension.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"definitions": {
		"datatypes": {
			"properties": {
				"uniqueStringArray": {
					"items": {
						"type": "string"
					},
					"type": "array",
					"uniqueItems": true
				}
			}
		},
		"schemas": {
			"properties": {
				"gradleCopySchema": {
					"dependencies": {
						"from": {
							"not": {
								"required": [
									"fromTask"
								]
							}
						},
						"fromTask": {
							"not": {
								"required": [
									"from"
								]
							}
						}
					},
					"properties": {
						"from": {
							"description": "The source directory to copy from. If none is provided, the yaml file's directory is used. Mutually exclusive with 'fromTask'.",
							"type": "string"
						},
						"fromTask": {
							"description": "The name of a Gradle task. The outputs of the declared task will be copied. Mutually exclusive with 'from'.",
							"type": "string"
						},
						"include": {
							"$ref": "#/definitions/datatypes/properties/uniqueStringArray",
							"description": "An array of glob patterns to include from the 'from' or 'fromTask' source. If none are provided, all contents will be copied."
						},
						"into": {
							"description": "The destination directory inside the project's build directory. If none is provided, it it will go to the build directory root.",
							"type": "string"
						}
					},
					"type": "object"
				}
			}
		}
	},
	"patternProperties": {
		"^(?!assemble$)[a-z][a-z-\\d]+$": {
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"const": "batch"
							}
						}
					},
					"then": {
						"description": "Description for batch",
						"properties": {
							"oAuthApplicationHeadlessServer": {
								"type": "string"
							}
						},
						"required": [
							"oAuthApplicationHeadlessServer"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "customElement"
							}
						}
					},
					"then": {
						"description": "Description for customElement",
						"properties": {
							"cssURLs": {
								"$ref": "#/definitions/datatypes/properties/uniqueStringArray"
							},
							"friendlyURLMapping": {
								"anyOf": [
									{
										"type": "null"
									},
									{
										"type": "string"
									}
								]
							},
							"htmlElementName": {
								"description": "A lower-case kebab-case name to be used for the custom element. Must contain at least one hyphen.",
								"pattern": "^[a-z]+-([a-z-]+)?[a-z]",
								"type": "string"
							},
							"instanceable": {
								"type": "boolean"
							},
							"jsonUrls": {
								"$ref": "#/definitions/datatypes/properties/uniqueStringArray"
							},
							"key": {
								"type": "string"
							},
							"portletCategoryName": {
								"type": "string"
							},
							"properties": {
								"type": "object"
							},
							"singleURL": {
								"type": "string"
							},
							"urls": {
								"$ref": "#/definitions/datatypes/properties/uniqueStringArray"
							},
							"useESM": {
								"type": "boolean"
							}
						},
						"required": [
							"htmlElementName",
							"urls"
						],
						"title": "Custom Element",
						"type": "object"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "editorConfigContributor"
							}
						}
					},
					"then": {
						"description": "Description for editorConfigContributor",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "fdsCellRenderer"
							}
						}
					},
					"then": {
						"description": "Description for fdsCellRenderer",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "fdsFilter"
							}
						}
					},
					"then": {
						"description": "Description for fdsFilter",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "globalCSS"
							}
						}
					},
					"then": {
						"description": "Description for globalCSS",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "globalJS"
							}
						}
					},
					"then": {
						"description": "Description for globalJS",
						"properties": {
							"scriptElementAttributes": {
								"additionalProperties": {
									"type": [
										"boolean",
										"integer",
										"number",
										"string"
									]
								},
								"description": "",
								"properties": {
									"src": false
								},
								"title": "Script Element Attributes",
								"type": "object"
							},
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						],
						"type": "object"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "iframe"
							}
						}
					},
					"then": {
						"description": "Description for iframe",
						"properties": {
							"portletCategoryName": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "instanceSettings"
							}
						}
					},
					"then": {
						"$ref": "./client-extension-type-instance-settings.schema.json",
						"description": "Description for instanceSettings"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "jsImportMapsEntry"
							}
						}
					},
					"then": {
						"description": "Description for jsImportMapsEntry",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "notificationType"
							}
						}
					},
					"then": {
						"description": "Description for notificationType",
						"properties": {
							"oAuth2ApplicationExternalReferenceCode": {
								"type": "string"
							},
							"resourcePath": {
								"type": "string"
							}
						},
						"required": [
							"oAuth2ApplicationExternalReferenceCode",
							"resourcePath"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "oAuthApplicationHeadlessServer"
							}
						}
					},
					"then": {
						"description": "Description for oAuthApplicationHeadlessServer",
						"properties": {
							".serviceAddress": {
								"type": "string"
							},
							".serviceScheme": {
								"type": "string"
							},
							"scopes": {
								"$ref": "#/definitions/datatypes/properties/uniqueStringArray"
							}
						},
						"required": [
							".serviceAddress",
							".serviceScheme",
							"scopes"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "oAuthApplicationUserAgent"
							}
						}
					},
					"then": {
						"description": "Description for oAuthApplicationUserAgent",
						"properties": {
							".serviceAddress": {
								"type": "string"
							},
							".serviceScheme": {
								"type": "string"
							},
							"scopes": {
								"$ref": "#/definitions/datatypes/properties/uniqueStringArray"
							}
						},
						"required": [
							".serviceAddress",
							".serviceScheme",
							"scopes"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "objectAction"
							}
						}
					},
					"then": {
						"description": "Description for objectAction",
						"properties": {
							"oAuth2ApplicationExternalReferenceCode": {
								"type": "string"
							},
							"resourcePath": {
								"type": "string"
							}
						},
						"required": [
							"oAuth2ApplicationExternalReferenceCode",
							"resourcePath"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "objectEntryManager"
							}
						}
					},
					"then": {
						"description": "Description for objectEntryManager",
						"properties": {
							"oAuth2ApplicationExternalReferenceCode": {
								"type": "string"
							},
							"resourcePath": {
								"type": "string"
							}
						},
						"required": [
							"oAuth2ApplicationExternalReferenceCode",
							"resourcePath"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "objectValidationRule"
							}
						}
					},
					"then": {
						"description": "Description for objectValidationRule",
						"properties": {
							"oAuth2ApplicationExternalReferenceCode": {
								"type": "string"
							},
							"resourcePath": {
								"type": "string"
							}
						},
						"required": [
							"oAuth2ApplicationExternalReferenceCode",
							"resourcePath"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "siteInitializer"
							}
						}
					},
					"then": {
						"description": "Description for siteInitializer",
						"properties": {
							"builtInTemplateKey": {
								"type": "string"
							},
							"builtInTemplateType": {
								"enum": [
									"site-initializer",
									"site-template"
								]
							},
							"membershipType": {
								"default": "open",
								"enum": [
									"open",
									"private",
									"restricted"
								]
							},
							"oAuthApplicationHeadlessServer": {
								"type": "string"
							},
							"parentSiteKey": {
								"type": "string"
							},
							"siteExternalReferenceCode": {
								"type": "string"
							},
							"siteName": {
								"type": "string"
							}
						},
						"required": [
							"oAuthApplicationHeadlessServer",
							"siteName",
							"siteExternalReferenceCode"
						],
						"type": "object"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "staticContent"
							}
						}
					},
					"then": {
						"description": "Description for staticContent"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "themeCSS"
							}
						}
					},
					"then": {
						"description": "Description for themeCSS",
						"properties": {
							"clayURL": {
								"type": "string"
							},
							"mainURL": {
								"type": "string"
							}
						},
						"type": "object"
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "themeFavicon"
							}
						}
					},
					"then": {
						"description": "Description for themeFavicon",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "themeSpritemap"
							}
						}
					},
					"then": {
						"description": "Description for themeSpritemap",
						"properties": {
							"url": {
								"type": "string"
							}
						},
						"required": [
							"url"
						]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "workflowAction"
							}
						}
					},
					"then": {
						"description": "Description for workflowAction",
						"properties": {
							"oAuth2ApplicationExternalReferenceCode": {
								"type": "string"
							},
							"resourcePath": {
								"type": "string"
							}
						},
						"required": [
							"oAuth2ApplicationExternalReferenceCode",
							"resourcePath"
						]
					}
				}
			],
			"description": "Kebab-case keys are treated as individual client extension definitions.",
			"properties": {
				"description": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"type": {
					"enum": [
						"batch",
						"customElement",
						"editorConfigContributor",
						"fdsCellRenderer",
						"fdsFilter",
						"globalCSS",
						"globalJS",
						"iframe",
						"instanceSettings",
						"jsImportMapsEntry",
						"notificationType",
						"oAuthApplicationHeadlessServer",
						"oAuthApplicationUserAgent",
						"objectAction",
						"objectEntryManager",
						"objectValidationRule",
						"siteInitializer",
						"staticContent",
						"themeCSS",
						"themeFavicon",
						"themeSpritemap",
						"workflowAction"
					]
				}
			},
			"required": [
				"type"
			],
			"type": "object"
		}
	},
	"properties": {
		"assemble": {
			"description": "Declares one or more copy schema definitions for copying resources to the client extension payload. The keys are used to construct a Gradle Copy task. See https://docs.gradle.org/current/dsl/org.gradle.api.tasks.Copy.html.",
			"items": {
				"$ref": "#/definitions/schemas/properties/gradleCopySchema"
			},
			"type": "array"
		}
	},
	"type": "object"
}