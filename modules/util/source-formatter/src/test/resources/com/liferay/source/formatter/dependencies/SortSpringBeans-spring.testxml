<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean class="com.liferay.portal.service.impl.GroupLocalServiceImpl" id="com.liferay.portal.kernel.service.GroupLocalService" />
	<bean class="com.liferay.portal.service.impl.CompanyLocalServiceImpl" id="com.liferay.portal.kernel.service.CompanyLocalService" />
	<bean class="com.liferay.portal.service.impl.AccountLocalServiceImpl" id="com.liferay.portal.kernel.service.AccountLocalService">
		<property name="accountPersistence" ref="com.liferay.portal.kernel.service.persistence.AccountPersistence" />
		<property name="counterLocalService" ref="com.liferay.counter.kernel.service.CounterLocalService" />
	</bean>
</beans>