Bundle-Version: 1.0.0
Import-Package: \
	!net.bytebuddy.*
-exportcontents:\
	net.bytebuddy.*;mandatory:=usage;usage=test
-fixupmessages:\
	Classes found in the wrong directory,\
	Export,\
	Unknown directive