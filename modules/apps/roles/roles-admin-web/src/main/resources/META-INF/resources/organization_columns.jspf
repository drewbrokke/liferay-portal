<c:choose>
	<c:when test='<%= displayStyle.equals("descriptive") %>'>
		<liferay-ui:search-container-column-text
			cssClass="lfr-sticker-column"
		>
			<clay:sticker
				icon="users"
				style="secondary"
			/>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-text
			colspan="<%= 2 %>"
		>
			<div class="list-group-title">
				<span><%= organization.getName() %></span>
			</div>

			<c:if test="<%= !Validator.isBlank(organization.getParentOrganizationName()) %>">
				<p class="list-group-text">
					<span><%= HtmlUtil.escape(organization.getParentOrganizationName()) %></span>
				</p>
			</c:if>

			<p class="list-group-text">
				<span><%= LanguageUtil.get(request, organization.getType()) %></span>
			</p>

			<c:if test="<%= !Validator.isBlank(organization.getAddress().getCity()) || !Validator.isBlank(UsersAdmin.ORGANIZATION_REGION_NAME_ACCESSOR.get(organization)) || !Validator.isBlank(UsersAdmin.ORGANIZATION_COUNTRY_NAME_ACCESSOR.get(organization)) %>">
				<p class="list-group-subtext">
					<c:if test="<%= !Validator.isBlank(organization.getAddress().getCity()) %>">
						<span><%= HtmlUtil.escape(organization.getAddress().getCity()) %></span>
					</c:if>

					<c:if test="<%= !Validator.isBlank(UsersAdmin.ORGANIZATION_REGION_NAME_ACCESSOR.get(organization)) %>">
						<span><%= UsersAdmin.ORGANIZATION_REGION_NAME_ACCESSOR.get(organization) %></span>
					</c:if>

					<c:if test="<%= !Validator.isBlank(UsersAdmin.ORGANIZATION_COUNTRY_NAME_ACCESSOR.get(organization)) %>">
						<span><%= UsersAdmin.ORGANIZATION_COUNTRY_NAME_ACCESSOR.get(organization) %></span>
					</c:if>
				</p>
			</c:if>
		</liferay-ui:search-container-column-text>
	</c:when>
	<c:when test='<%= displayStyle.equals("icon") %>'>

		<%
		row.setCssClass("entry-card lfr-asset-item selectable");
		%>

		<liferay-ui:search-container-column-text>
			<liferay-frontend:icon-vertical-card
				actionJspServletContext="<%= application %>"
				cssClass="entry-display-style"
				icon="users"
				resultRow="<%= row %>"
				rowChecker="<%= organizationSearchContainer.getRowChecker() %>"
				subtitle="<%= LanguageUtil.get(request, organization.getType()) %>"
				title="<%= organization.getName() %>"
			/>
		</liferay-ui:search-container-column-text>
	</c:when>
	<c:otherwise>
		<liferay-ui:search-container-column-text
			cssClass="table-cell-content"
			name="name"
		>
			<div class="table-title">
				<span class="text-truncate-inline">
					<span class="text-truncate" title="<%= organization.getName() %>"><%= organization.getName() %></span>
				</span>
			</div>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-text
			cssClass="table-cell-content"
			name="parent-organization"
		>
			<span class="text-truncate-inline">
				<span class="text-truncate" title="<%= HtmlUtil.escape(organization.getParentOrganizationName()) %>"><%= HtmlUtil.escape(organization.getParentOrganizationName()) %></span>
			</span>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-text
			name="type"
			value="<%= LanguageUtil.get(request, organization.getType()) %>"
		/>

		<liferay-ui:search-container-column-text
			name="city"
			value="<%= HtmlUtil.escape(organization.getAddress().getCity()) %>"
		/>

		<liferay-ui:search-container-column-text
			name="region"
			value="<%= UsersAdmin.ORGANIZATION_REGION_NAME_ACCESSOR.get(organization) %>"
		/>

		<liferay-ui:search-container-column-text
			name="country"
			value="<%= UsersAdmin.ORGANIZATION_COUNTRY_NAME_ACCESSOR.get(organization) %>"
		/>
	</c:otherwise>
</c:choose>