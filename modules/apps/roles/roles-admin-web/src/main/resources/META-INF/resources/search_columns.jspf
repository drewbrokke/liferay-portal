<c:choose>
	<c:when test='<%= displayStyle.equals("descriptive") %>'>
		<liferay-ui:search-container-column-text
			cssClass="lfr-sticker-column"
		>
			<clay:sticker
				icon="users"
				style="secondary"
			/>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-text
			colspan="<%= 2 %>"
		>
			<div class="list-group-title">
				<span class="text-truncate-inline">
					<clay:link
						elementClasses="text-truncate"
						href="<%= (rowURL != null) ? rowURL.toString() : null %>"
						label="<%= HtmlUtil.escape(role.getTitle(locale)) %>"
						title="<%= HtmlUtil.escape(role.getTitle(locale)) %>"
					/>
				</span>
			</div>

			<p class="list-group-subtext">
				<span><%= HtmlUtil.escape(role.getDescription(locale)) %></span>
			</p>

			<p class="list-group-text">
				<span><%= _getAssigneesMessage(request, role) %></span>
			</p>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-jsp
			path="/role_action.jsp"
		/>
	</c:when>
	<c:when test='<%= displayStyle.equals("icon") %>'>

		<%
		row.setCssClass("entry-card lfr-asset-item");
		%>

		<liferay-ui:search-container-column-text>
			<liferay-frontend:icon-vertical-card
				actionJsp="/role_action.jsp"
				actionJspServletContext="<%= application %>"
				icon="users"
				resultRow="<%= row %>"
				rowChecker="<%= searchContainer.getRowChecker() %>"
				subtitle="<%= _getAssigneesMessage(request, role) %>"
				title="<%= HtmlUtil.escape(role.getTitle(locale)) %>"
				url="<%= (rowURL != null) ? rowURL.toString() : null %>"
			/>
		</liferay-ui:search-container-column-text>
	</c:when>
	<c:otherwise>
		<liferay-ui:search-container-column-text
			cssClass="table-cell-content"
			name="title"
		>
			<div class="table-title">
				<clay:link
					href="<%= rowURL.toString() %>"
					label="<%= HtmlUtil.escape(role.getTitle(locale)) %>"
				/>
			</div>
		</liferay-ui:search-container-column-text>

		<c:if test="<%= (PropsValues.ROLES_ORGANIZATION_SUBTYPES.length > 0) || (PropsValues.ROLES_REGULAR_SUBTYPES.length > 0) || (PropsValues.ROLES_SITE_SUBTYPES.length > 0) %>">
			<liferay-ui:search-container-column-text
				name="subType"
			>
				<clay:link
					elementClasses="table-link"
					href="<%= rowURL.toString() %>"
					label="<%= LanguageUtil.get(request, role.getSubtype()) %>"
				/>
			</liferay-ui:search-container-column-text>
		</c:if>

		<liferay-ui:search-container-column-text
			cssClass="table-cell-content"
			name="description"
		>
			<clay:link
				elementClasses="table-link"
				href="<%= rowURL.toString() %>"
				label="<%= HtmlUtil.escape(role.getDescription(locale)) %>"
			/>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-text
			cssClass="table-cell-content"
			name="number-of-assignees"
		>
			<clay:link
				elementClasses="table-link"
				href="<%= rowURL.toString() %>"
				label='<%= _isImpliedRole(role) ? LanguageUtil.get(request, "not-available") : String.valueOf(RoleLocalServiceUtil.getAssigneesTotal(role.getRoleId())) %>'
			/>
		</liferay-ui:search-container-column-text>

		<liferay-ui:search-container-column-jsp
			path="/role_action.jsp"
		/>
	</c:otherwise>
</c:choose>