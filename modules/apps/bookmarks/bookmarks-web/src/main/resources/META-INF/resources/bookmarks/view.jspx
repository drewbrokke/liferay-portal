<jsp:root
	version="2.1"
	xmlns:aui="http://liferay.com/tld/aui"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:clay="http://liferay.com/tld/clay"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:liferay-frontend="http://liferay.com/tld/frontend"
	xmlns:liferay-portlet="http://liferay.com/tld/portlet"
	xmlns:liferay-trash="http://liferay.com/tld/trash"
	xmlns:liferay-ui="http://liferay.com/tld/ui"
	xmlns:liferay-util="http://liferay.com/tld/util"
	xmlns:portlet="http://xmlns.jcp.org/portlet_3_0"
>
	<jsp:directive.page contentType="text/html" pageEncoding="UTF-8" />

	<portlet:defineObjects />

	<liferay-ui:success key="${namespace}requestProcessed" message="your-request-completed-successfully" />

	<portlet:actionURL copyCurrentRenderParameters="true" name="~bookmarks~edit_entry" var="restoreTrashEntriesURL">
		<portlet:param name="cmd" value="restore" />
	</portlet:actionURL>

	<liferay-trash:undo
		portletURL="${restoreTrashEntriesURL}"
	/>

	<clay:management-toolbar
		infoPanelId="infoPanelId"
		managementToolbarDisplayContext="${managementToolbarViewState}"
		propsTransformer="bookmarks/js/BookmarksManagementToolbarPropsTransformer"
		searchContainerId="bookmarks"
	/>

	<div class="closed sidenav-container sidenav-right" id="${namespace}infoPanelId">
		<liferay-portlet:resourceURL copyCurrentRenderParameters="false" id="~bookmarks~info_panel" var="sidebarPanelURL">
			<portlet:param name="folderId" value="${folderId}" />
		</liferay-portlet:resourceURL>

		<liferay-frontend:sidebar-panel
			resourceURL="${sidebarPanelURL}"
			searchContainerId="bookmarks"
		>
			<liferay-util:include page="/bookmarks/info_panel.jsp" servletContext="${application}" />
		</liferay-frontend:sidebar-panel>

		<div class="sidenav-content">
			<clay:container-fluid
				cssClass="container-view"
			>
				<div class="bookmarks-breadcrumb" id="${namespace}breadcrumbContainer">
					<c:if test='${(searchContainerViewState.navigation != "recent") and (searchContainerViewState.navigation != "mine")}'>
						<liferay-ui:breadcrumb
							showCurrentGroup="false"
							showGuestGroup="false"
							showLayout="false"
							showParentGroups="false"
						/>
					</c:if>
				</div>

				<aui:form action="${editEntryURL}" method="get" name="fm">
					<aui:input name="cmd" type="hidden" />
					<aui:input name="redirect" type="hidden" value="${currentURL}" />
					<aui:input name="newFolderId" type="hidden" />

					<jsp:include
						page="/bookmarks/view_bookmarks.jspx"
					/>
				</aui:form>
			</clay:container-fluid>
		</div>
	</div>

	<portlet:actionURL name="~bookmarks~edit_entry" var="editEntryURL" />

	<portlet:renderURL var="moveEntryURL">
		<portlet:param name="mvcRenderCommandName" value="~bookmarks~move_entry" />
		<portlet:param name="redirect" value="${currentURL}" />
	</portlet:renderURL>

	<aui:script use="liferay-bookmarks">
		var bookmarks = new Liferay.Portlet.Bookmarks({
			editEntryUrl: '${editEntryURL}',
			form: {
				method: 'POST',
				node: A.one(document.${namespace}fm),
			},
			moveEntryUrl: '${moveEntryURL}',
			namespace: '${namespace}',
			searchContainerId: 'bookmarks',
		});
	</aui:script>
</jsp:root>