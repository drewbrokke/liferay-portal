<jsp:root
	version="2.1"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:liferay-security="http://liferay.com/tld/security"
	xmlns:liferay-ui="http://liferay.com/tld/ui"
	xmlns:portlet="http://xmlns.jcp.org/portlet_3_0"
>
	<c:set value="${SEARCH_CONTAINER_RESULT_ROW.object}" var="bookmark" />

	<portlet:renderURL var="viewBookmarkURL">
		<!-- MVC parameters -->
		<portlet:param name="bookmarkId" value="${bookmark.bookmarkId}" />
		<portlet:param name="mvcRenderCommandName" value="~bookmarks~view_${bookmark.entityName}" />
		<portlet:param name="parentFolderId" value="${bookmark.parentFolderId}" />
		<!-- SearchContainer view state -->
		<portlet:param name="categoryId" value="${searchContainerViewState.categoryId}" />
		<portlet:param name="cur" value="${searchContainerViewState.cur}" />
		<portlet:param name="delta" value="${searchContainerViewState.delta}" />
		<portlet:param name="displayStyle" value="${searchContainerViewState.displayStyle}" />
		<portlet:param name="navigation" value="${searchContainerViewState.navigation}" />
		<portlet:param name="orderByCol" value="${searchContainerViewState.orderByCol}" />
		<portlet:param name="orderByType" value="${searchContainerViewState.orderByType}" />
		<portlet:param name="resetCur" value="${searchContainerViewState.resetCur}" />
		<portlet:param name="tag" value="${searchContainerViewState.tag}" />
	</portlet:renderURL>

	<liferay-ui:icon-menu
		markupView="lexicon"
	>
		<c:if test="${currentUser.signedIn and currentUser.mayViewBookmark(bookmark)}">
			<c:choose>
				<c:when test="${bookmark.folder}">
					<liferay-ui:icon
						message="view"
						url="${viewBookmarkURL}"
					/>
				</c:when>
				<c:otherwise>
					<liferay-ui:icon
						message="view"
						url="${pathMain}/bookmarks/open_entry?entryId=${bookmark.bookmarkId}"
					/>
				</c:otherwise>
			</c:choose>
		</c:if>

		<c:if test="${currentUser.mayEditBookmark(bookmark)}">
			<portlet:renderURL var="editBookmarkURL">
				<!-- MVC parameters -->
				<portlet:param name="bookmarkId" value="${bookmark.bookmarkId}" />
				<portlet:param name="mvcRenderCommandName" value="~bookmarks~edit_${bookmark.entityName}" />
				<portlet:param name="parentFolderId" value="${bookmark.parentFolderId}" />
				<!-- SearchContainer view state -->
				<portlet:param name="categoryId" value="${searchContainerViewState.categoryId}" />
				<portlet:param name="cur" value="${searchContainerViewState.cur}" />
				<portlet:param name="delta" value="${searchContainerViewState.delta}" />
				<portlet:param name="displayStyle" value="${searchContainerViewState.displayStyle}" />
				<portlet:param name="navigation" value="${searchContainerViewState.navigation}" />
				<portlet:param name="orderByCol" value="${searchContainerViewState.orderByCol}" />
				<portlet:param name="orderByType" value="${searchContainerViewState.orderByType}" />
				<portlet:param name="resetCur" value="${searchContainerViewState.resetCur}" />
				<portlet:param name="tag" value="${searchContainerViewState.tag}" />
			</portlet:renderURL>

			<liferay-ui:icon
				message="edit"
				url="${editBookmarkURL}"
			/>

			<portlet:renderURL var="moveBookmarkURL">
				<!-- MVC parameters -->
				<portlet:param name="${bookmark.entry ? 'bookmarkId' : 'rowIdsBookmarksFolder'}" value="${bookmark.bookmarkId}" />
				<portlet:param name="mvcRenderCommandName" value="~bookmarks~move_entry" />
				<portlet:param name="parentFolderId" value="${bookmark.parentFolderId}" />
				<!-- SearchContainer view state -->
				<portlet:param name="categoryId" value="${searchContainerViewState.categoryId}" />
				<portlet:param name="cur" value="${searchContainerViewState.cur}" />
				<portlet:param name="delta" value="${searchContainerViewState.delta}" />
				<portlet:param name="displayStyle" value="${searchContainerViewState.displayStyle}" />
				<portlet:param name="navigation" value="${searchContainerViewState.navigation}" />
				<portlet:param name="orderByCol" value="${searchContainerViewState.orderByCol}" />
				<portlet:param name="orderByType" value="${searchContainerViewState.orderByType}" />
				<portlet:param name="resetCur" value="${searchContainerViewState.resetCur}" />
				<portlet:param name="tag" value="${searchContainerViewState.tag}" />
			</portlet:renderURL>

			<liferay-ui:icon
				message="move"
				url="${moveBookmarkURL}"
			/>
		</c:if>

		<c:if test="${currentUser.mayPermissionBookmark(bookmark)}">
			<liferay-security:permissionsURL
				modelResource="${bookmark.modelResource}"
				modelResourceDescription="${bookmark.description}"
				resourcePrimKey="${bookmark.bookmarkId}"
				var="permissionBookmarkURL"
			/>

			<liferay-ui:icon
				message="permissions"
				url="${permissionBookmarkURL}"
			/>
		</c:if>

		<c:if test="${bookmark.entry and currentUser.maySubscribeToBookmark(bookmark)}">
			<c:set value="${currentUser.isSubscribedToBookmark(bookmark) ? 'unsubscribe' : 'subscribe'}" var="subscriptionAction" />

			<portlet:actionURL name="~bookmarks~edit_${bookmark.entityName}" var="subscriptionActionURL">
				<!-- MVC parameters -->
				<portlet:param name="bookmarkId" value="${bookmark.bookmarkId}" />
				<portlet:param name="cmd" value="${subscriptionAction}" />
				<!-- SearchContainer view state -->
				<portlet:param name="categoryId" type="render" value="${searchContainerViewState.categoryId}" />
				<portlet:param name="cur" type="render" value="${searchContainerViewState.cur}" />
				<portlet:param name="delta" type="render" value="${searchContainerViewState.delta}" />
				<portlet:param name="displayStyle" type="render" value="${searchContainerViewState.displayStyle}" />
				<portlet:param name="navigation" type="render" value="${searchContainerViewState.navigation}" />
				<portlet:param name="orderByCol" type="render" value="${searchContainerViewState.orderByCol}" />
				<portlet:param name="orderByType" type="render" value="${searchContainerViewState.orderByType}" />
				<portlet:param name="resetCur" type="render" value="${searchContainerViewState.resetCur}" />
			</portlet:actionURL>

			<liferay-ui:icon
				message="${subscriptionAction}"
				url="${subscriptionActionURL}"
			/>
		</c:if>

		<c:if test="${currentUser.mayDeleteBookmark(bookmark)}">
			<portlet:actionURL name="~bookmarks~edit_${bookmark.entityName}" var="deleteBookmarkURL">
				<!-- MVC parameters -->
				<portlet:param name="bookmarkId" value="${bookmark.bookmarkId}" />
				<portlet:param name="cmd" value="${trashEnabled ? 'move_to_trash' : 'delete'}" />
				<!-- SearchContainer view state -->
				<portlet:param name="categoryId" type="render" value="${searchContainerViewState.categoryId}" />
				<portlet:param name="cur" type="render" value="${searchContainerViewState.cur}" />
				<portlet:param name="delta" type="render" value="${searchContainerViewState.delta}" />
				<portlet:param name="displayStyle" type="render" value="${searchContainerViewState.displayStyle}" />
				<portlet:param name="navigation" type="render" value="${searchContainerViewState.navigation}" />
				<portlet:param name="orderByCol" type="render" value="${searchContainerViewState.orderByCol}" />
				<portlet:param name="orderByType" type="render" value="${searchContainerViewState.orderByType}" />
				<portlet:param name="resetCur" type="render" value="${searchContainerViewState.resetCur}" />
			</portlet:actionURL>

			<liferay-ui:icon-delete
				trash="${trashEnabled}"
				url="${deleteBookmarkURL}"
			/>
		</c:if>

		<c:if test="${bookmark.folder and currentUser.mayPublishBookmark(bookmark)}">
			<portlet:actionURL name="/bookmarks/publish_folder" var="publishFolderURL">
				<portlet:param name="folderId" value="${bookmark.bookmarkId}" />
			</portlet:actionURL>

			<liferay-ui:icon-delete
				confirmation="are-you-sure-you-want-to-publish-the-selected-folder"
				message="publish-to-live"
				url="${publishFolderURL}"
			/>
		</c:if>
	</liferay-ui:icon-menu>
</jsp:root>