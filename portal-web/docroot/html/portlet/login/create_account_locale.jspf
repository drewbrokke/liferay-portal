<aui:select label="locale" name="languageId">

	<%
	Locale[] locales = LanguageUtil.getAvailableLocales();

	for (Locale curLocale : locales) {
	%>
		<aui:option label="<%= curLocale.getDisplayName(curLocale) %>" lang="<%= LocaleUtil.toW3cLanguageId(curLocale) %>" selected="<%= (locale.getLanguage().equals(curLocale.getLanguage()) && locale.getCountry().equals(curLocale.getCountry())) %>" value="<%= LocaleUtil.toLanguageId(curLocale) %>" />

	<%
	}
	%>

</aui:select>

<portlet:actionURL var="createAccountAjaxURL" windowState="<%= LiferayWindowState.EXCLUSIVE.toString() %>">
	<portlet:param name="struts_action" value="/login/create_account" />
</portlet:actionURL>

<aui:script sandbox="<%= true %>" use='liferay-portlet-url'>
	var select = $('#<portlet:namespace />languageId');

	var createAccountAjaxURL = Liferay.PortletURL.createURL('<%= createAccountAjaxURL %>');

	select.on('change', function(event) {
		var formData = $('#<portlet:namespace />fm').formToArray();

		createAccountAjaxURL.setParameter('languageId', select.val());

		$.ajax(
			createAccountAjaxURL.toString(),
			{
				complete: function() {
					formData.forEach(function(field) {
						var node = $('#' + field.name);

						if (node) {
							node.val(field.value);
						}
					});
				},
				success: function(responseData) {
					$('#p_p_id<portlet:namespace /> .portlet-body').html(responseData);
				}
			}
		)
	});
</aui:script>