<%
Boolean autoFocus = windowState.equals(WindowState.MAXIMIZED);

for (Map<String, Object> userField: userFields) {
	String name = (String)userField.get("name");
	boolean required = Boolean.valueOf((Boolean)userField.get("required"));
	String[] options = (String[])userField.get("options");
%>
	<c:if test="<%= Validator.isNull(options) %>">
		<aui:input autoFocus="<%= autoFocus %>" model="<%= User.class %>" name="<%= name %>">
			<c:if test="<%= required %>">
				<aui:validator name="required" />
			</c:if>
		</aui:input>
	</c:if>
<%
	autoFocus = false;
}
%>